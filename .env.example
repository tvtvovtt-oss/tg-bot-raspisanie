# ===================================================================
# Пример конфигурации переменных окружения (.env)
# Скопируйте этот файл в .env и укажите свои значения:
# cp .env.example .env
# ===================================================================

# Токен вашего Telegram-бота, полученный от @BotFather (обязательно)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram ID главных администраторов через запятую (полный доступ: /admin, рассылки, статистика, тех. перерыв)
# Узнать свой ID можно через бота @userinfobot
ADMIN_IDS=5966353805,7218741941

# Telegram ID администраторов с доступом ТОЛЬКО к статистике и аналитике (/statadmin, /stats)
STAT_ADMIN_IDS=

# Путь к файлу базы данных SQLite:
# - Для Railway / Docker с примонтированным томом в /app/data: /app/data/bot.db
# - Для локального запуска на компьютере: bot.db
DATABASE_PATH=/app/data/bot.db

# ID закрытого Telegram-канала для автоматического сохранения и восстановления базы данных (рекомендуется)
# Если бот перезапускается или передеплоивается без постоянного диска (Railway/Render/etc.),
# он автоматически выгружает бэкап в этот канал каждые 30 минут и при выключении,
# а при новом старте скачивает актуальную базу и восстанавливает всех пользователей и рассылки!
# Бот должен быть добавлен в этот канал администратором с правом "Закреплять сообщения".
# ID канала начинается с -100 (например, -1001234567890). Узнать ID можно переслав сообщение из канала в @userinfobot
BACKUP_CHANNEL_ID=

# Базовый адрес официального сайта техникума (по умолчанию https://almetpt.ru)
ALMETPT_BASE_URL=https://almetpt.ru

# Фоновые автоматические уведомления об изменениях в расписании (false - выкл, true - вкл)
ENABLE_NOTIFICATIONS=false

# Прокси (необязательно, нужен только при необходимости обхода блокировок: http://host:port или socks5://host:port)
# PROXY_URL=http://127.0.0.1:10809
